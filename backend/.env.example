PORT=4000

# Leave MONGODB_URI empty for local development: the server will spin up an
# in-memory MongoDB automatically. Set it to a real MongoDB Atlas connection
# string for anything persistent (staging/production).
MONGODB_URI=

JWT_SECRET=change-this-to-a-long-random-string

CORS_ORIGIN=http://localhost:3000

# Optional: if set, and no admin user exists yet, one is created automatically
# on server startup. Handy for local dev with the in-memory database (which
# resets every restart, so `npm run seed:admin` alone won't reach it). Not
# needed once MONGODB_URI points at a persistent database with an admin
# already seeded via `npm run seed:admin`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
